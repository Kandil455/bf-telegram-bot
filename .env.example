# ── Required ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=               # from @BotFather (rotate it if it was ever committed)
GEMINI_API_KEY=                   # best: vision (images) + JSON. Server-side only.
GROQ_API_KEY=                     # fast text fallback
OPENROUTER_API_KEY=               # last-resort fallback

# ── Runtime ────────────────────────────────────────────────
BOT_MODE=polling                  # polling (default, works on any VPS/Botkeep) | webhook (requires PUBLIC_URL)
PUBLIC_URL=                          # required only in webhook mode
TELEGRAM_WEBHOOK_SECRET=             # required in webhook mode (any long random string)
PORT=8080

# ── Behaviour ──────────────────────────────────────────────
ADMIN_TELEGRAM_IDS=                  # comma-separated numeric ids; they get unlimited tasks and /stats
FREE_DAILY_TASKS=10                  # tasks per user per day (summary, quiz, cards, key points)
MAX_FILE_MB=20                       # Telegram bot download limit is 20 MB
DATA_DIR=./data                      # where sessions and quota counters are stored
GEMINI_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-super-120b-a12b:free

# ── Premium icons (optional) ───────────────────────────────
# Filled by: npm run emoji -- <custom_emoji_set_name>
PREMIUM_EMOJI_SET=                # name of your custom-emoji set, e.g. blackfighters_icons_by_yourbot (IDs are read automatically at startup)
PREMIUM_EMOJI_JSON=

# ── v3 additions ───────────────────────────────────────────
ADMIN_TOKEN=                      # web admin at /admin; at least 24 random characters, or leave empty to disable
REDIS_URL=                        # optional: redis://... for persistence across restarts and redeploys
TZ_OFFSET_HOURS=0                 # your users' UTC offset for flashcard reminders, e.g. 2 for Cairo in summer
PRO_DAILY_TASKS=120               # daily tasks on the Pro plan
PRO_STARS=150                     # price of one Pro month, in Telegram Stars

# ── Vodafone Cash (automatic verification from SMS) ─────────
CASH_NUMBER=                      # the Vodafone Cash number that receives payments
CASH_SMS_SECRET=                  # shared secret the phone sends in the X-SMS-Secret header (20+ characters)
PRO_EGP=100                       # Pro price in Egyptian pounds
CASH_TX_REGEX=                    # optional: override how the transaction number is found (one capture group)
CASH_AMOUNT_REGEX=                # optional: override how the amount is found (one capture group)

# ── v3.3: files, images, quizzes, output formats ───────────
FREE_FILES_PER_DAY=2              # uploads per user per day (free)
PRO_FILES_PER_DAY=10              # uploads per user per day (Pro)
MAX_QUESTIONS_PER_FILE=30         # quiz questions per file, across all its quizzes
MAX_IMAGES_PER_FILE=40            # images taken out of one file
IMAGE_REVIEW=on                   # on: AI reviews each image (keeps or drops it). off: keep all, student decides
PDFIMAGES_BIN=pdfimages           # poppler tool that extracts images from PDFs
CHROME_PATH=                      # chromium path to enable PDF output, e.g. /usr/bin/chromium-browser

# ── v3.5: quality, throttling, subscriptions ───────────────
QUIZ_VERIFY=on                    # on: a second AI pass checks every quiz question against the source (recommended)
THROTTLE_MS=1500                  # a user's second heavy request inside this window is slowed down (0 disables)

# ── v3.7 ───────────────────────────────────────────────────
REQUIRE_PHONE=on                  # every user shares their own number (Telegram button) before the bot works for them
ENFORCE_LIMITS_FOR_ADMINS=off     # off: admins are unlimited. on: admins get the same daily limits, to test them
MAX_TEXT_CHARS=250000             # how much text is read from one file (a notice is shown if it is cut)
# CHROME_PATH is optional now: the bot looks for Chrome, Chromium or Edge on this machine

# ── v3.8: model tiers and OCR ──────────────────────────────
GEMINI_MODEL_FAST=                # light model for reading, OCR and image review (leave empty to use GEMINI_MODELS)
GEMINI_MODEL_QUALITY=             # strong model for summaries and quizzes (leave empty to use GEMINI_MODELS)
PDFTOPPM_BIN=pdftoppm             # poppler tool that renders scanned PDF pages for OCR

# ── v3.9: Mini App, admin tools ────────────────────────────
APP_URL=                          # public https address of the Mini App (defaults to the webhook's address)

# ── Channel subscription & Referrals ────────────────────────
REQUIRED_CHANNEL=                 # e.g. @your_channel or -100123456789 (leave empty to disable forced join)
CHANNEL_INVITE_LINK=              # optional link if channel is private, e.g. https://t.me/your_channel
REFERRAL_BONUS_FILES=1            # extra files granted for TODAY to a user when their invited friend joins
